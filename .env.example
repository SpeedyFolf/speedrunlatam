PUID=1000
PGID=1000
SERVER_PORT=22003
SERVER_DOWNLOAD_PORT=22005
SERVER_MEMORY=4096
SERVER_MAXPLAYERS=70
SERVER_FPSLIMIT=300
SERVER_NAME=Speedrun LATAM
OWNER_EMAIL=
# IP o dominio alcanzable por los clientes. 127.0.0.1 solo sirve si el
# cliente corre en la misma máquina.
HTTP_DOWNLOAD_URL=http://127.0.0.1:22005
NEON_AUTH=disabled
NEON_REGISTRY=1
NEON_REGISTRY_PUBLIC_HOST=
NEON_REGISTRY_TAGLINE=
NEON_REGISTRY_DESCRIPTION=
NEON_REGISTRY_COUNTRIES=
NEON_REGISTRY_LANGUAGES=
NEON_REGISTRY_WEBSITE=
NEON_REGISTRY_DISCORD=
NEON_REGISTRY_LOGO=
NEON_REGISTRY_BANNER=
NEON_REGISTRY_ACCENT=
TZ=America/Argentina/Buenos_Aires
# El agente de deploy queda apagado en local para no tocar el bind mount
# ./server. Para probarlo, usá una copia del volumen y poné DEPLOY_AGENT=1.
DEPLOY_AGENT=0
DEPLOY_ALLOWED_REPO=ferecece/speedrunlatam
DEPLOY_BACKUP_KEEP=3
DEPLOY_MAX_ASSET_MB=160
