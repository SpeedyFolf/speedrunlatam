worker_processes auto;
worker_rlimit_nofile 65535;
pid /tmp/nginx.pid;

events {
    worker_connections 8192;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    access_log /home/container/logs/nginx-access.log combined buffer=32k flush=5s;
    error_log /home/container/logs/nginx-error.log warn;

    client_body_temp_path /tmp/nginx-client-body;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    keepalive_timeout 75s;
    keepalive_requests 10000;

    reset_timedout_connection on;
    send_timeout 300s;
    client_header_timeout 15s;
    client_body_timeout 15s;

    output_buffers 4 64k;

    open_file_cache max=20000 inactive=60s;
    open_file_cache_valid 30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/javascript
               application/json application/xml application/octet-stream;

    server {
        listen {{SERVER_DOWNLOAD_PORT}} backlog=4096;
        server_name _;

        root /home/container/mods/deathmatch/resource-cache/http-client-files;
        autoindex off;

        # Recursos web internos de MTA: nunca públicos.
        location ~* ^/(webadmin|webstats|web_toptimes|ajax|resourcebrowser|resourcemanager|performancebrowser|elementbrowser|webmap)/ {
            return 404;
        }

        location ~ /\. {
            deny all;
        }

        location / {
            try_files $uri =404;
        }
    }
}
