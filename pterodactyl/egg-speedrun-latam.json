{
  "_comment": "Speedrun LATAM server egg",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-11-07T00:00:00+00:00",
  "name": "Speedrun LATAM",
  "author": "ferecece@users.noreply.github.com",
  "description": "Servidor Speedrun LATAM. Motor: San Andreas Online.",
  "features": null,
  "docker_images": {
    "ghcr.io/ferecece/speedrunlatam:latest": "ghcr.io/ferecece/speedrunlatam:latest"
  },
  "file_denylist": [],
  "startup": "./mta-server64 --port {{SERVER_PORT}} --httpport 22007 -n",
  "config": {
    "files": "{}",
    "startup": "{\"done\":\"Server started and is ready to accept connections!\"}",
    "logs": "{}",
    "stop": "shutdown"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n/opt/install-server.sh /mnt/server",
      "container": "ghcr.io/ferecece/speedrunlatam:latest",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Download Port",
      "description": "Puerto público de descargas de resources (nginx). Debe estar asignado como allocation TCP.",
      "env_variable": "SERVER_DOWNLOAD_PORT",
      "default_value": "22005",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|between:1,65535",
      "field_type": "text"
    },
    {
      "name": "Server Name",
      "description": "Nombre visible en el navegador de servidores.",
      "env_variable": "SERVER_NAME",
      "default_value": "Speedrun LATAM",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:255",
      "field_type": "text"
    },
    {
      "name": "Owner Email",
      "description": "Email de contacto del servidor. Puede quedar vacío.",
      "env_variable": "OWNER_EMAIL",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|email",
      "field_type": "text"
    },
    {
      "name": "Download URL",
      "description": "URL pública de descargas de resources. Obligatoria: debe apuntar al puerto de descargas.",
      "env_variable": "HTTP_DOWNLOAD_URL",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|url",
      "field_type": "text"
    },
    {
      "name": "Max Players",
      "description": "Cantidad máxima de jugadores conectados.",
      "env_variable": "SERVER_MAXPLAYERS",
      "default_value": "70",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|between:1,4096",
      "field_type": "text"
    },
    {
      "name": "Max FPS",
      "description": "Límite máximo de FPS para los clientes. 0 usa el ajuste del cliente.",
      "env_variable": "SERVER_FPSLIMIT",
      "default_value": "300",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|between:0,32767",
      "field_type": "text"
    },
    {
      "name": "GitHub Token",
      "description": "Opcional. Solo si el repositorio o el release son privados.",
      "env_variable": "GITHUB_TOKEN",
      "default_value": "",
      "user_viewable": false,
      "user_editable": true,
      "rules": "nullable|string",
      "field_type": "text"
    }
  ]
}
