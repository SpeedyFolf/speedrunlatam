<def name="Any Order Checkpoints">
	<element name="checkpoint_any_order" friendlyname="Checkpoint (Any Order)" icon="CP.png">
		<data name="position" type="coord3d" default="0,0,0"></data>
		<data name="type" type="selection:checkpoint,ring,corona,cylinder,arrow" description="Checkpoints extend vertically infinitely and use the circle collision shape. Rings, coronas, and arrows use the sphere collision shape. Cylinders use the tube collision shape." default="ring"></data>
		<data name="color" type="color" description="Color (#RRGGBBAA hex string)." default="#F0F9"></data>
		<data name="blipcolor" type="color" description="Blip color (#RRGGBBFF hex string)." default="#F0F9"></data>
		<data name="size" type="number" description="The radius of the checkpoint." default="1"></data>
		<data name="height" type="number" description="The height of the checkpoint (cylinders only). 2 for default." required="false" default=""></data>
		<data name="extracolshapesize" type="integer" default="0" description="How much bigger the checkpoint's hitbox is compared to its visual appearance. Standard race gamemode value is 4." required="false"></data>
		<data name="blipsize" type="number" description="Blip size" default="1"></data>
		<marker color="!color!" type="!type!" size="!size!"></marker>
	</element>
</def>
