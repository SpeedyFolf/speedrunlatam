<def name="Interiors">
	<element name="interiorEntry" friendlyname="Interior warp source">
		<marker type="arrow" size="2.2" color="#e1ff00c8" interior="!interior!"></marker>
		<ped interior="!interior!"></ped>
		<data name="position" type="coord3d" required="true" default="0,0,0"></data>
		<data name="rotation" type="coord3d" required="true" default="0,0,0"></data>
		<data name="interior" type="integer" description="GTA interior world" default="0"></data>
		<data name="dimension" type="integer" description="MTA dimension" default="0"></data>
	</element>
	<element name="interiorReturn" friendlyname="Interior warp return">
		<marker type="arrow" size="2.2" color="#e1ff00c8" interior="!interior!"></marker>
		<ped interior="!interior!"></ped>
		<data name="refid" type="element:interiorEntry" required="true" default=""></data>
		<data name="position" type="coord3d" required="true" default="0,0,0"></data>
		<data name="rotation" type="coord3d" required="true" default="0,0,0"></data>
		<data name="interior" type="integer" description="GTA interior world" default="0"></data>
		<data name="dimension" type="integer" description="MTA dimension" default="0"></data>
	</element>
</def>
