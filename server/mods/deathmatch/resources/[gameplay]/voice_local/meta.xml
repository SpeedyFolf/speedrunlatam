<meta>
	<info author="MTA contributors (github.com/multitheftauto/mtasa-resources)" version="1.1" name="Local voice chat" description="This resource implements a voice chat where only nearby players can talk to eachother" type="script"></info>

	<min_mta_version server="1.3.0-0.04570"></min_mta_version>

	<settings>
		<setting name="*max_voice_distance" value="[25]"></setting>
		<setting name="*voice_sound_boost" value="[6]"></setting>
		<setting name="*show_talking_icon" value="[true]"></setting>
	</settings>

	<file src="icon.png"></file>

	<script src="shared.lua" type="shared"></script>
	<script src="client.lua" type="client"></script>
	<script src="server.lua" type="server"></script>
</meta>
