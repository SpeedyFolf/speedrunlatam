<meta>
	<info author="Talidan" name="RealDriveby" description="Real drive-bys" type="script" version="2.0.0"></info>
	<script src="driveby_client.lua" type="client"></script>
	<script src="exports_client.lua" type="client"></script>
	<script src="driveby_server.lua" type="server"></script>
	<script src="exports_server.lua" type="server"></script>

	<!--utils-->
	<script src="utils/textlib.lua" type="client"></script>
	<script src="utils/client_anim.lua" type="client"></script>
	<script src="utils/textlib_anim.lua" type="client"></script>

	<settings>
		<!--Weapon ids that the driver can use.  For no weapons just use "[[ ]]"-->
		<setting name="driveby_driver" value="[[ 22,23,24,26,28,29,32 ]]"></setting>

		<!--Weapon ids that passngers can use-->
		<setting name="driveby_passenger" value="[[ 22,23,24,25,26,28,29,32,30,31,33 ]]"></setting>

		<!--Defines the shot delay for individual weapons that arent meant for driveby, in the format of 'weapon':time(ms)-->
		<setting name="driveby_shot_delay" value="[{ '22':300,'23':300,'24':800,'26':700, '27':330 }]"></setting>

		<!--Vehicles that cannot be drivebyd inside-->
		<setting name="driveby_blocked_vehicles" value="[[ 432,601,437,431,592,553,577,488,497,548,563,512,476,447,425,519,520,460,417,469,487,513,441,464,501,465,564,538,449,537,539,570472,473,493,595,484,430,453,452,446,454,606,591,607,611,610,590,569,611,435,608,584,450 ]]"></setting>

		<!--Whether or not turning should be enabled for vehicles (excluding bikes) while in driveby mode-->
		<setting name="driveby_steer_cars" value="[true]"></setting>

		<!--Whether or not turning should be enabled for bikes/motorbikes while in driveby mode-->
		<setting name="driveby_steer_bikes" value="[true]"></setting>

		<!--Whether a weapon should be equiped as soon as you enter a vehicle. -->
		<setting name="driveby_auto_equip" value="[false]"></setting>

		<!--Block instant eject when using driveby while exiting vehicle -->
		<setting name="block_instant_eject" value="[true]"></setting>

		<!--Whether or not is driveby enabled for all players by default -->
		<setting name="driveby_enabled" value="[true]"></setting>
	</settings>
	<export function="setDriverDrivebyAbility" type="client"></export>
	<export function="setPassengerDrivebyAbility" type="client"></export>
	<export function="getDriverDrivebyAbility" type="client"></export>
	<export function="getPassengerDrivebyAbility" type="client"></export>
	<export function="setWeaponShotDelay" type="client"></export>
	<export function="getWeaponShotDelay" type="client"></export>
	<export function="setDrivebySteeringAbility" type="client"></export>
	<export function="getDrivebySteeringAbility" type="client"></export>
	<export function="setDrivebyAutoEquip" type="client"></export>
	<export function="getDrivebyAutoEquip" type="client"></export>
	<export function="isDrivebyEnabled" type="shared"></export>
	<export function="setDrivebyEnabled" type="shared"></export>
</meta>
