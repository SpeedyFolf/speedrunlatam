    <script src="logic/player_stats.lua" type="server" />
    <script src="server/missions.lua" type="server" />
    <script src="server/player_state.lua" type="server" />
    <script src="server/driveby.lua" type="server" />
    <script src="server/instances.lua" type="server" />
    <script src="server/ambient.lua" type="server" />
    <script src="server/wanted.lua" type="server" />
    <script src="server/records.lua" type="server" />
    <script src="server/vote.lua" type="server" />
    <script src="server/main.lua" type="server" />

