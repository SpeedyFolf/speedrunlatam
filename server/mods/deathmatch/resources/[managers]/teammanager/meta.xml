<meta>
	<info author="Talidan" version="1.0.0" description="Utility resource to handle teams"></info>
	<script src="main.lua" type="server"></script>
	<script src="main_client.lua" type="client"></script>
	<script src="drawdefinitions.lua" type="client"></script>
	<script src="draw.lua" type="client"></script>

	<file src="images/backdrop.png"></file>
	<file src="images/team.png"></file>

 	<export function="handlePlayer" type="server"></export>
	<export function="handlePlayer" type="client"></export>
	<export function="autoBalance" type="server"></export>

	<settings>
		<!-- "balance_teams" means that when trying to join a team,
		you wont be able to join a team with too many players in already -->
		<setting name="balance_teams" value="[ true ]"></setting>

		<!-- "balance_threshold" means the amount of difference there
		has to be between teams to enable "balance_teams" -->
		<setting name="balance_threshold" value="[1]"></setting>

		<!-- "autobalance_teams" means that teammanager will allow gamemodes to
		forcefully move players to another team if the teams are unfair -->
		<setting name="autobalance_teams" value="[ true ]"></setting>

		<!-- "autobalance_threshold" means the amount of times the gamemode
		requests for a forced autobalance before it is taken into effect -->
		<setting name="autobalance_threshold" value="[3]"></setting>

		<!-- "friendly_fire" sets whether friendly fire is enabled.  'true'
		means players will take damage when shot. -->
		<setting name="friendly_fire" value="[ false ]"></setting>

	</settings>
</meta>
